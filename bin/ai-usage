#!/usr/bin/env python3
"""Collect cost reports and subscription quotas for detected AI tools as JSON.

Cursor comes from ~/.local/bin/cursor-spend (dashboard API); Claude from its local session logs and OpenCode from its SQLite database;
DeepSeek from the DeepSeek Harness session logs in ~/.dsh/sessions, priced at its published API rates;
Pi from the cost it records in ~/.pi/agent/sessions.
Read by the AI Usage menu bar app. Prints one JSON object to stdout.
"""
import json
import fcntl
import glob
import math
import os
import tempfile
import re
import selectors
import signal
import shutil
import subprocess
import sys
import time
from collections import defaultdict
from concurrent.futures import ThreadPoolExecutor
from datetime import date, datetime, timedelta, timezone
from importlib.machinery import SourceFileLoader

HOME = os.path.expanduser("~")
CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "ai-usage", "config.json")
DATA_HOME = os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local/share"))


def configuration():
    try:
        with open(CONFIG) as f:
            config = json.load(f)
        if not isinstance(config, dict):
            raise ValueError("Configuration must contain a JSON object")
        return config
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as err:
        raise RuntimeError(f"Cannot read {CONFIG}. Fix or restore this file before changing preferences: {err}") from err


def tool_budget(tool_id):
    budget = configuration().get("tools", {}).get(tool_id, {}).get("budget")
    if not budget:
        return None
    amount = float(budget["amount"])
    if not math.isfinite(amount) or amount <= 0 or budget.get("period") not in ("daily", "monthly"):
        raise ValueError("Budget must be positive with daily or monthly period")
    return {"amount": amount, "period": budget["period"]}


def global_budget():
    config = configuration()
    if "AI_USAGE_DAILY_BUDGET" in os.environ:
        amount = float(os.environ["AI_USAGE_DAILY_BUDGET"])
    elif "globalBudget" in config:
        budget = config["globalBudget"]
        amount = float(budget["amount"]) if budget else 0
    else:
        amount = float(config.get("dailyBudget", 0))
    if not math.isfinite(amount) or amount < 0:
        raise ValueError("Global daily budget must be finite and non-negative")
    return {"amount": amount, "period": "daily"} if amount else None


def tool_enabled(tool_id):
    return configuration().get("tools", {}).get(tool_id, {}).get("enabled", True) is not False


def output_payload(tools, available=None):
    """`available` lists every detected tool (enabled or not) so the app can offer the filter."""
    budget = global_budget()
    listed = [{"id": t["id"], "name": t["name"], "enabled": True} for t in tools] if available is None else \
             [{"id": s[0], "name": s[1], "enabled": tool_enabled(s[0])} for s in available]
    return {"updatedAt": datetime.now().astimezone().isoformat(timespec="seconds"),
            # Required numeric field for old app binaries. New UI reads globalBudget.
            "budget": budget["amount"] if budget else 60.0,
            "globalBudget": budget,
            "indicator": configuration().get("indicator", {"mode": "summary"}),
            "availableTools": listed,
            "tools": tools}


def update_configuration(update):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    lock_path = CONFIG + ".lock"
    with open(lock_path, "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        config = configuration()
        update(config)
        fd, tmp = tempfile.mkstemp(prefix=".config-", dir=os.path.dirname(CONFIG))
        try:
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "w") as f:
                json.dump(config, f, indent=2)
                f.write("\n")
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, CONFIG)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
        fcntl.flock(lock, fcntl.LOCK_UN)


def _tool_preference(config, tool_id):
    return config.setdefault("tools", {}).setdefault(tool_id, {})


HISTORY_DAYS = 14
ENV = {**os.environ, "PATH": f"{HOME}/.local/bin:{HOME}/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:{os.environ.get('PATH', '')}"}

today = date.today()
week_start = today - timedelta(days=today.weekday())
month_start = today.replace(day=1)
history_start = today - timedelta(days=HISTORY_DAYS - 1)


def history(by_day):
    return [{"date": (history_start + timedelta(days=i)).isoformat(),
             "cost": round(by_day.get(history_start + timedelta(days=i), 0.0), 4)}
            for i in range(HISTORY_DAYS)]


def period_totals(by_day):
    return {
        "today": by_day.get(today, 0.0),
        "week": sum(cost for day, cost in by_day.items() if day >= week_start),
        "month": sum(cost for day, cost in by_day.items() if day >= month_start),
    }


def top_models(by_model):
    return [{"name": n.split("/")[-1], "cost": round(c, 4)}
            for n, c in sorted(by_model.items(), key=lambda kv: -kv[1])[:5] if c > 0]


def cursor_limit(spend, period_start):
    """Plan spend limit from the editor's cached usage snapshot, in dollars."""
    snapshot = json.loads(spend.read_state("aiSettings.enterprisePlanUsageSnapshot") or "{}")
    for chart in snapshot.get("charts", []):
        if chart.get("periodStartMs") == period_start:
            cents = json.loads(chart.get("response") or "{}").get("effectiveLimitCents")
            return cents / 100 if cents else None
    return None


CURSOR_CACHE = os.path.join(HOME, "Library/Caches/ai-usage-cursor-events.json")
DAY_MS = 86_400_000


def cursor_events(spend, token, team, user, start_ms):
    """Events since start_ms. Older days come from a local cache; only the newest day is refetched."""
    cached = []
    try:
        with open(CURSOR_CACHE) as f:
            blob = json.load(f)
        if blob["startMs"] <= start_ms and blob["team"] == team and blob["user"] == user:
            cached = [e for e in blob["events"] if int(e.get("timestamp") or 0) >= start_ms]
    except (OSError, ValueError, KeyError, TypeError):
        pass
    newest = max((int(e.get("timestamp") or 0) for e in cached), default=0)
    fetch_from = max(start_ms, newest - DAY_MS) if cached else start_ms
    fresh = spend.fetch(token, team, user, fetch_from, int(time.time() * 1000) + 60_000)
    events = [e for e in cached if int(e.get("timestamp") or 0) < fetch_from] + fresh
    try:
        os.makedirs(os.path.dirname(CURSOR_CACHE), exist_ok=True)
        tmp = f"{CURSOR_CACHE}.tmp"
        with open(tmp, "w") as f:
            json.dump({"startMs": start_ms, "team": team, "user": user, "events": events}, f)
        os.replace(tmp, CURSOR_CACHE)
    except OSError:
        pass
    return events


def cursor():
    here = os.path.join(os.path.dirname(os.path.realpath(__file__)), "cursor-spend")
    installed = os.path.join(HOME, ".local/bin/cursor-spend")
    spend = SourceFileLoader("cursor_spend", here if os.path.isfile(here) else installed).load_module()
    if not os.path.isfile(spend.STATE_DB):
        raise RuntimeError("Cursor not found. Install and sign in to Cursor, or turn it off in the gear menu.")
    token = spend.access_token()
    team, user, period_start, period_end = spend.identity()
    if not token or not team or not user:
        raise RuntimeError(getattr(spend, "LAST_ERROR", None) or "Not signed in to Cursor. Open Cursor and its usage panel once.")
    period_ms = period_start or int(datetime.combine(month_start, datetime.min.time()).timestamp() * 1000)
    period_label = datetime.fromtimestamp(period_ms / 1000).strftime("%b %-d")
    start = min(datetime.fromtimestamp(period_ms / 1000).date(), history_start, week_start)
    start_ms = int(datetime.combine(start, datetime.min.time()).timestamp() * 1000)
    try:
        events = cursor_events(spend, token, team, user, start_ms)
    except spend.urllib.error.HTTPError as err:
        raise RuntimeError(f"Cursor dashboard HTTP {err.code}. Reopen Cursor.")

    by_day, by_model = defaultdict(float), defaultdict(float)
    by_chat = defaultdict(lambda: [0.0, ""])
    billing_total = last_hour = 0.0
    hour_ago_ms = (time.time() - 3600) * 1000
    for e in events:
        ts = int(e.get("timestamp") or 0)
        day = datetime.fromtimestamp(ts / 1000).date()
        cost = spend.dollars(e)
        by_day[day] += cost
        if ts >= period_ms:
            billing_total += cost
        if ts >= hour_ago_ms:
            last_hour += cost
        if day == today:
            by_model[e.get("model") or "?"] += cost
            chat = by_chat[e.get("conversationId") or "none"]
            chat[0] += cost
            chat[1] = e.get("model") or "?"

    top_chats = sorted(by_chat.items(), key=lambda kv: -kv[1][0])[:3]
    names = spend.titles([cid for cid, _ in top_chats])
    return {
        **period_totals(by_day),
        "monthLabel": f"Calendar month since {month_start.strftime('%b %-d')}",
        "billingPeriod": {"amount": billing_total, "label": f"Billing period since {period_label}"},
        "daily": history(by_day),
        "models": top_models(by_model),
        "limit": cursor_limit(spend, period_start),
        "periodEnd": datetime.fromtimestamp(period_end / 1000).date().isoformat() if period_end else None,
        "rate": last_hour,
        "chats": [{"name": names[cid] if cid != "none" else "No chat (inline / tab)", "cost": round(c, 4), "model": m}
                  for cid, (c, m) in top_chats if c > 0],
    }


# DeepSeek API list prices in USD per 1M tokens, off-peak: (cache-miss input, cache-hit input, output).
# Peak windows are weekdays 01:00-04:00 and 06:00-10:00 UTC at twice these rates; Chinese public
# holidays are always off-peak and are not modelled here.
DEEPSEEK_PRICES = {"deepseek-flash": (0.15, 0.003, 0.6),
                   "deepseek-v4-pro": (0.66, 0.022, 1.98)}
DEEPSEEK_ALIASES = {"deepseek-v4-flash": "deepseek-flash",
                    "deepseek-v4-flash-vision-exp": "deepseek-flash",
                    "deepseek-v4.1-flash": "deepseek-flash"}
DEEPSEEK_PEAK_HOURS = ((1, 4), (6, 10))


def deepseek_sessions_dir():
    return os.path.join(HOME, ".dsh", "sessions")


def deepseek_peak(moment):
    return moment.weekday() < 5 and any(start <= moment.hour < end for start, end in DEEPSEEK_PEAK_HOURS)


def deepseek_cost(usage, model, stamp):
    """USD cost of one usage sample, or None when the model has no price row."""
    rates = DEEPSEEK_PRICES.get(DEEPSEEK_ALIASES.get(model, model))
    if rates is None:
        return None
    try:
        moment = datetime.fromtimestamp((stamp or 0) / 1000, tz=timezone.utc)
    except (OverflowError, OSError, ValueError):
        moment = datetime.now(timezone.utc)
    miss, hit, output = (rate * 2 for rate in rates) if deepseek_peak(moment) else rates
    tokens = (usage.get("inputTokens") or 0) + (usage.get("cacheWriteTokens") or 0)
    return (tokens * miss + (usage.get("cacheReadTokens") or 0) * hit
            + (usage.get("outputTokens") or 0) * output) / 1_000_000


def decompress_zstd(path):
    try:
        from compression import zstd as stdlib_zstd
    except ImportError:
        stdlib_zstd = None
    if stdlib_zstd is not None:
        with open(path, "rb") as log:
            return stdlib_zstd.decompress(log.read()).decode("utf-8", "replace")
    binary = shutil.which("zstd", path=ENV["PATH"])
    if not binary:
        raise RuntimeError("Cannot read DeepSeek Harness logs: install zstd (brew install zstd) "
                           "or run the collector with Python 3.14+.")
    result = subprocess.run([binary, "-dc", path], capture_output=True, timeout=120)
    if result.returncode:
        raise RuntimeError(result.stderr.decode(errors="replace").strip()
                           or f"Cannot decompress {os.path.basename(path)}")
    return result.stdout.decode("utf-8", "replace")


def session_records(path):
    if path.endswith(".zstd"):
        text = decompress_zstd(path)
    else:
        with open(path, encoding="utf-8", errors="replace") as log:
            text = log.read()
    for line in text.splitlines():
        try:
            record = json.loads(line)
        except ValueError:
            continue
        if isinstance(record, dict):
            yield record


def deepseek_session(path):
    """Session title and its own billable samples, skipping a fork's inherited prefix."""
    title, boundary, header_model = "", 0, None
    samples = {}
    for index, record in enumerate(session_records(path)):
        kind, data = record.get("type"), record.get("data") or {}
        if kind == "session":
            boundary = int(data.get("inheritedEventCount") or data.get("seedLength") or 0)
        elif boundary and index <= boundary:
            continue
        elif kind == "session/title":
            title = data.get("title") or title
        elif kind == "request/header":
            config = (data.get("header") or {}).get("config") or {}
            header_model = config.get("model") or header_model
        elif kind == "assistant/message" and data.get("usage"):
            source = (data.get("message") or {}).get("source") or {}
            # DSH overwrites a step's sample on retry, so the last one for (turn, step) bills.
            samples[(data.get("turn"), data.get("step"))] = (
                record.get("time"), data["usage"], source.get("model") or header_model)
    return title, list(samples.values())


def deepseek():
    root = deepseek_sessions_dir()
    if not os.path.isdir(root):
        raise RuntimeError("DeepSeek Harness not found. Open it once, or turn it off in the gear menu.")
    by_day, by_model, unpriced = defaultdict(float), defaultdict(float), set()
    chats, last_hour = [], 0.0
    hour_ago_ms = (time.time() - 3600) * 1000
    for path in glob.glob(os.path.join(root, "*", "*", "session.v*.jsonl*")):
        title, samples = deepseek_session(path)
        session_today, session_models = 0.0, defaultdict(float)
        for stamp, usage, model in samples:
            cost = deepseek_cost(usage, model, stamp)
            if cost is None:
                unpriced.add(model or "unknown")
                continue
            moment = datetime.fromtimestamp((stamp or 0) / 1000)
            by_day[moment.date()] += cost
            if (stamp or 0) >= hour_ago_ms:
                last_hour += cost
            if moment.date() == today:
                by_model[model] += cost
                session_today += cost
                session_models[model] += cost
        if session_today > 0:
            best = max(session_models.items(), key=lambda pair: pair[1])[0]
            chats.append({"name": title or os.path.basename(os.path.dirname(os.path.dirname(path))),
                          "cost": round(session_today, 4), "model": best})
    if unpriced:
        raise RuntimeError(f"No DeepSeek price for {', '.join(sorted(unpriced))}. Update bin/ai-usage.")
    return {
        **period_totals(by_day),
        "monthLabel": f"Since {month_start.strftime('%b %-d')}",
        "daily": history(by_day),
        "models": top_models(by_model),
        "rate": last_hour,
        "chats": sorted(chats, key=lambda chat: -chat["cost"])[:3],
    }


# USD per million tokens: input, output, cache write (5m), cache read. Anthropic list prices.
CLAUDE_PRICES = {
    "claude-opus-5-5": (4, 20, 5, 0.2),
    "claude-sonnet-5-5": (2, 10, 2.5, 0.1),
    "claude-haiku-5-5": (0.1, 0.5, 0.125, 0.01),
    "claude-opus-4": (5, 25, 6.25, 0.5),
    "claude-sonnet-4": (3, 15, 3.75, 0.3),
    "claude-haiku-4": (1, 5, 1.25, 0.1),
}
BLOCK_HOURS = 5


def claude_price(model):
    for prefix in sorted(CLAUDE_PRICES, key=len, reverse=True):
        if model.startswith(prefix):
            return CLAUDE_PRICES[prefix]
    return None


def claude_cost(usage, rates):
    """1-hour cache writes cost twice the input rate; 5-minute writes use the listed cache-write rate."""
    price_in, price_out, price_write, price_read = rates
    write = usage.get("cache_creation_input_tokens") or 0
    hour = min((usage.get("cache_creation") or {}).get("ephemeral_1h_input_tokens") or 0, write)
    return ((usage.get("input_tokens") or 0) * price_in + (usage.get("output_tokens") or 0) * price_out
            + (write - hour) * price_write + hour * 2 * price_in + (usage.get("cache_read_input_tokens") or 0) * price_read) / 1e6


def claude_roots():
    configured = [p for p in os.environ.get("CLAUDE_CONFIG_DIR", "").split(",") if p.strip()]
    roots = [os.path.join(p.strip(), "projects") for p in configured] or [
        os.path.join(HOME, ".claude/projects"), os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "claude/projects")]
    return [r for r in roots if os.path.isdir(r)]


def claude_entries(since):
    """One entry per API message with its USD cost. Files untouched since `since` are skipped."""
    cutoff = datetime.combine(since, datetime.min.time()).timestamp()
    seen = set()
    for root in claude_roots():
        for path in glob.glob(os.path.join(root, "*", "**", "*.jsonl"), recursive=True):
            try:
                if os.path.getmtime(path) < cutoff:
                    continue
                project = os.path.relpath(path, root).split(os.sep)[0]
                with open(path, errors="replace") as f:
                    for line in f:
                        if '"usage"' not in line or '"assistant"' not in line:
                            continue
                        try:
                            row = json.loads(line)
                            message = row.get("message") or {}
                            usage, model = message.get("usage"), message.get("model") or ""
                            when = datetime.fromisoformat(row["timestamp"].replace("Z", "+00:00")).astimezone()
                        except (ValueError, KeyError, AttributeError, TypeError):
                            continue
                        if row.get("type") != "assistant" or not isinstance(usage, dict) or model.startswith("<"):
                            continue
                        key = (message.get("id"), row.get("requestId"))
                        if key[0] and key[1]:
                            if key in seen:
                                continue
                            seen.add(key)
                        rates = claude_price(model)
                        cost = claude_cost(usage, rates) if rates else 0.0
                        yield {"when": when, "model": model, "cost": cost, "session": row.get("sessionId") or os.path.basename(path)[:-6],
                               "project": project, "known": rates is not None}
            except OSError:
                continue


def active_block_rate(entries):
    """Cost per hour of the active 5h billing block (blocks start at the hour of their first message)."""
    start = end = None
    cost = 0.0
    for e in sorted(entries, key=lambda e: e["when"]):
        if end is None or e["when"] >= end:
            start = e["when"].replace(minute=0, second=0, microsecond=0)
            end, cost = start + timedelta(hours=BLOCK_HOURS), 0.0
        cost += e["cost"]
    now = datetime.now().astimezone()
    if end is None or now >= end:
        return 0.0
    return cost / max((now - start).total_seconds() / 3600, 0.25)


CLAUDE_USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
CLAUDE_QUOTA_WINDOWS = (("five_hour", "5 horas", 300), ("seven_day", "Semanal", 10080))


def claude_oauth_token():
    """Subscription token from the Claude Code Keychain item, or None. Other services' entries in that item are never read."""
    try:
        result = subprocess.run(["/usr/bin/security", "find-generic-password", "-s", "Claude Code-credentials", "-w"],
                                capture_output=True, text=True, timeout=20)
        oauth = (json.loads(result.stdout).get("claudeAiOauth") or {}) if result.returncode == 0 else {}
    except (OSError, ValueError, subprocess.SubprocessError, AttributeError):
        return None
    expires = oauth.get("expiresAt")
    if not oauth.get("accessToken") or (isinstance(expires, (int, float)) and expires / 1000 < time.time()):
        return None
    return oauth["accessToken"]


def parse_claude_quotas(payload):
    quotas = []
    for key, label, minutes in CLAUDE_QUOTA_WINDOWS:
        window = (payload or {}).get(key)
        if not isinstance(window, dict) or not isinstance(window.get("utilization"), (int, float)):
            continue
        try:
            resets = datetime.fromisoformat(window["resets_at"].replace("Z", "+00:00")).timestamp() if window.get("resets_at") else None
        except (ValueError, AttributeError):
            resets = None
        quotas.append({"id": f"claude-{key}", "label": label, "usedPercent": min(100.0, max(0.0, float(window["utilization"]))),
                       "resetsAt": resets, "windowMins": minutes})
    return quotas


def claude_quotas():
    """5-hour and weekly subscription windows. Empty when not signed in with a subscription or when the call fails."""
    import urllib.request
    token = claude_oauth_token()
    if not token:
        return []
    request = urllib.request.Request(CLAUDE_USAGE_URL, headers={"Authorization": f"Bearer {token}", "anthropic-beta": "oauth-2025-04-20",
                                                                "User-Agent": "ai-usage-bar"})
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            return parse_claude_quotas(json.load(response))
    except (OSError, ValueError):
        return []


def claude():
    entries = list(claude_entries(min(history_start, week_start, month_start)))
    by_day, by_model, projects = defaultdict(float), defaultdict(float), {}
    totals, models = defaultdict(float), defaultdict(lambda: defaultdict(float))
    for e in entries:
        day = e["when"].date()
        by_day[day] += e["cost"]
        totals[e["session"]] += e["cost"]
        models[e["session"]][e["model"]] += e["cost"]
        if day == today:
            by_model[e["model"]] += e["cost"]
            projects[e["session"]] = e["project"]
    top = sorted((s for s in projects if totals[s] > 0), key=lambda s: -totals[s])[:3]
    chats = [{"name": claude_title(projects[s], s), "cost": round(totals[s], 4),
              "model": max(models[s], key=models[s].get).split("/")[-1]} for s in top]
    recent = [e for e in entries if e["when"].date() >= today - timedelta(days=1)]
    result = {**period_totals(by_day), "monthLabel": f"Since {month_start.strftime('%b %-d')}", "daily": history(by_day),
              "models": top_models(by_model), "rate": active_block_rate(recent), "chats": chats}
    quotas = claude_quotas()
    if quotas:
        result["quotas"] = quotas
    return result


def claude_title(project_path, session_id):
    path = os.path.join(HOME, ".claude/projects", project_path, f"{session_id}.jsonl")
    title = prompt = None
    try:
        with open(path, errors="replace") as f:
            for line in f:
                if '"custom-title"' in line:
                    title = json.loads(line).get("customTitle") or title
                elif '"last-prompt"' in line:
                    prompt = json.loads(line).get("lastPrompt") or prompt
    except (OSError, ValueError):
        pass
    return title or (prompt or "")[:60] or project_path.rsplit("-", 1)[-1]


def is_free_model(name):
    model = name.rsplit("/", 1)[-1].casefold()
    return model == "free" or model.endswith(("-free", ":free"))


def opencode():
    """OpenCode stores the cost of each assistant message in its SQLite database."""
    import sqlite3
    path = os.path.join(DATA_HOME, "opencode/opencode.db")
    if not os.path.exists(path):
        raise RuntimeError("OpenCode database not found at ~/.local/share/opencode/opencode.db")
    since = datetime.combine(min(history_start, week_start, month_start), datetime.min.time()).timestamp() * 1000
    db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
    queries = (  # legacy `message` rows, then the current `session_message` rows
        "SELECT session_id, json_extract(data,'$.modelID'), json_extract(data,'$.cost'), "
        "COALESCE(json_extract(data,'$.time.created'), time_created) FROM message "
        "WHERE json_extract(data,'$.role')='assistant' AND json_extract(data,'$.cost') > 0",
        "SELECT session_id, json_extract(data,'$.model.id'), json_extract(data,'$.cost'), "
        "COALESCE(json_extract(data,'$.time.created'), time_created) FROM session_message "
        "WHERE type='assistant' AND json_extract(data,'$.cost') > 0")
    rows = []
    try:
        for query in queries:
            try:
                rows += db.execute(query).fetchall()
            except sqlite3.OperationalError:
                continue
    finally:
        db.close()
    by_day, by_model, sessions, totals = defaultdict(float), defaultdict(float), {}, defaultdict(float)
    for session, model, cost, created in rows:
        model = model or "?"
        if is_free_model(model):
            continue
        day = datetime.fromtimestamp(created / 1000).date()
        totals[session] += cost
        sessions.setdefault(session, {})[model] = sessions.get(session, {}).get(model, 0) + cost
        if created >= since:
            by_day[day] += cost
            if day == today:
                by_model[model] += cost
                sessions[session]["_today"] = 1
    top = sorted((s for s in totals if sessions[s].get("_today")), key=lambda s: -totals[s])[:3]
    titles = opencode_titles(top) if top else {}
    chats = [{"name": titles.get(s) or s[:12], "cost": round(totals[s], 4),
              "model": max((m for m in sessions[s] if m != "_today"), key=sessions[s].get).split("/")[-1]} for s in top]
    return {**period_totals(by_day), "monthLabel": f"Since {month_start.strftime('%b %-d')}", "daily": history(by_day),
            "models": top_models(by_model), "rate": 0.0, "chats": chats}


def opencode_titles(ids):
    import sqlite3
    path = os.path.join(DATA_HOME, "opencode/opencode.db")
    titles = {}
    db = None
    try:
        db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
        available = {row[0] for row in db.execute("SELECT name FROM sqlite_master WHERE type='table'")}
        marks = ",".join("?" * len(ids))
        for table in ("session", "session_v2"):  # session_v2 is current, session holds older rows
            if table not in available:
                continue
            try:
                titles.update({k: v for k, v in db.execute(f"SELECT id, title FROM {table} WHERE id IN ({marks})", ids) if v})
            except sqlite3.Error:
                continue
    except sqlite3.Error:
        pass
    finally:
        if db is not None:
            db.close()
    return titles


def pi_sessions_dir():
    return expand_path(os.environ.get("PI_CODING_AGENT_SESSION_DIR") or os.path.join(HOME, ".pi/agent/sessions"))


def pi_entries(since):
    """Usage-bearing Pi entries with their USD cost. Forks copy entries with the same id, so each id counts once."""
    cutoff = datetime.combine(since, datetime.min.time()).timestamp()
    seen = set()
    # Timestamp-prefixed names sort originals before their forks, so copied entries stay with the source session.
    for path in sorted(glob.glob(os.path.join(pi_sessions_dir(), "**", "*.jsonl"), recursive=True), key=os.path.basename):
        try:
            if os.path.getmtime(path) < cutoff:
                continue
            session, title = os.path.basename(path)[:-6], None
            with open(path, errors="replace") as f:
                for line in f:
                    try:
                        entry = json.loads(line)
                    except ValueError:
                        continue
                    if not isinstance(entry, dict):
                        continue
                    kind = entry.get("type")
                    if kind == "session":
                        session = entry.get("id") or session
                        continue
                    if kind == "session_info" and entry.get("name"):
                        title = entry["name"]
                        continue
                    message = entry.get("message") if kind == "message" else None
                    if message is not None and message.get("role") != "assistant":
                        continue
                    usage = (message or entry).get("usage")
                    cost = (usage or {}).get("cost") if isinstance(usage, dict) else None
                    if not isinstance(cost, dict) or not isinstance(cost.get("total"), (int, float)):
                        continue
                    key = (entry.get("id"), entry.get("timestamp"))
                    if key[0]:
                        if key in seen:
                            continue
                        seen.add(key)
                    try:
                        when = datetime.fromisoformat(str(entry["timestamp"]).replace("Z", "+00:00")).astimezone()
                    except (KeyError, ValueError):
                        continue
                    model = (message or entry).get("model") or kind
                    yield {"when": when, "model": str(model), "cost": number(cost["total"]), "session": session, "title": title}
        except OSError:
            continue


def pi():
    if not os.path.isdir(pi_sessions_dir()):
        raise RuntimeError("Pi sessions not found at ~/.pi/agent/sessions")
    entries = list(pi_entries(min(history_start, week_start, month_start)))
    titles = {}
    for e in entries:
        if e["title"]:
            titles[e["session"]] = e["title"]
    return spec_usage(None, entries=[{**e, "title": titles.get(e["session"])} for e in entries])


PLUGIN_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.join(HOME, ".config")), "ai-usage", "tools")
BUILTIN_IDS = {"codex", "cursor", "claude", "opencode", "deepseek", "pi"}
PLUGIN_ID = re.compile(r"^[a-z][a-z0-9-]{1,31}$")
PLUGIN_FIELDS = ("timestamp", "model", "session", "cost", "input", "output", "cacheRead", "cacheWrite", "id", "title")


def expand_path(path):
    return os.path.expanduser(os.path.expandvars(path))


def dig(obj, path):
    """Value at a dotted path such as `message.usage.input_tokens` or `parts.0.id`; None when absent."""
    for part in str(path).split("."):
        if isinstance(obj, list):
            try:
                obj = obj[int(part)]
            except (ValueError, IndexError):
                return None
        elif isinstance(obj, dict):
            obj = obj.get(part)
        else:
            return None
        if obj is None:
            return None
    return obj


def number(value):
    return float(value) if isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value) else 0.0


def validate_spec(spec):
    """Return the reason a tool spec is unusable, or None."""
    if not isinstance(spec, dict):
        return "must be a JSON object"
    if not PLUGIN_ID.match(str(spec.get("id", ""))):
        return "id must be 2-32 chars: lowercase letters, digits, dashes, starting with a letter"
    if spec["id"] in BUILTIN_IDS:
        return f"id {spec['id']} is built in"
    if not isinstance(spec.get("name"), str) or not spec["name"].strip():
        return "name is required"
    source = spec.get("source")
    if not isinstance(source, dict) or source.get("type") not in ("jsonl", "sqlite"):
        return "source.type must be jsonl or sqlite"
    if source["type"] == "jsonl" and not isinstance(source.get("glob"), str):
        return "jsonl sources need a glob"
    if source["type"] == "sqlite" and not (isinstance(source.get("path"), str) and isinstance(source.get("query"), str)):
        return "sqlite sources need a path and a query"
    fields = spec.get("fields") if source["type"] == "jsonl" else {}
    if source["type"] == "jsonl" and (not isinstance(fields, dict) or "timestamp" not in fields
                                      or not set(fields) <= set(PLUGIN_FIELDS)):
        return f"fields needs a timestamp and only these keys: {', '.join(PLUGIN_FIELDS)}"
    if spec.get("timeUnit", "iso") not in ("iso", "ms", "s"):
        return "timeUnit must be iso, ms or s"
    return None


def load_tool_specs(directory=None):
    """(valid specs, {file: problem}) from the user's tool spec directory."""
    specs, problems = [], {}
    for path in sorted(glob.glob(os.path.join(directory or PLUGIN_DIR, "*.json"))):
        try:
            with open(path) as f:
                spec = json.load(f)
        except (OSError, ValueError) as err:
            problems[os.path.basename(path)] = f"not readable JSON ({err})"
            continue
        problem = validate_spec(spec)
        if problem:
            problems[os.path.basename(path)] = problem
        elif any(spec["id"] == other["id"] for other in specs):
            problems[os.path.basename(path)] = f"duplicate id {spec['id']}"
        else:
            specs.append(spec)
    return specs, problems


def spec_present(spec):
    source = spec["source"]
    paths = spec.get("detect") or [source.get("glob") or source.get("path")]
    return any(glob.glob(expand_path(p)) for p in paths if isinstance(p, str))


def parse_time(value, unit):
    if value is None:
        raise ValueError("no timestamp")
    if unit == "iso":
        return datetime.fromisoformat(str(value).replace("Z", "+00:00")).astimezone()
    return datetime.fromtimestamp(number(value) / (1000 if unit == "ms" else 1)).astimezone()


def spec_cost(spec, row):
    """Reported cost times costScale, otherwise tokens priced per million from the spec's pricing table."""
    fields, scale = spec.get("fields") or {}, number(spec.get("costScale", 1)) or 1
    if row.get("cost") is not None and isinstance(row["cost"], (int, float)):
        return number(row["cost"]) * scale
    pricing = spec.get("pricing") or {}
    model = str(row.get("model") or "")
    rates = pricing.get("default") or {k: v for k, v in pricing.items() if k != "models"}
    for prefix in sorted(pricing.get("models") or {}, key=len, reverse=True):
        if model.startswith(prefix):
            rates = pricing["models"][prefix]
            break
    return sum(number(row.get(k)) * number(rates.get(k)) for k in ("input", "output", "cacheRead", "cacheWrite")) / 1e6


def spec_rows(spec, since):
    source = spec["source"]
    cutoff = datetime.combine(since, datetime.min.time()).timestamp()
    if source["type"] == "jsonl":
        fields, conditions = spec["fields"], spec.get("where") or []
        for path in glob.glob(expand_path(source["glob"]), recursive=True):
            try:
                if os.path.getmtime(path) < cutoff:
                    continue
                with open(path, errors="replace") as f:
                    for line in f:
                        try:
                            obj = json.loads(line)
                        except ValueError:
                            continue
                        if not isinstance(obj, dict) or any(dig(obj, c.get("path", "")) != c.get("equals") for c in conditions):
                            continue
                        row = {key: dig(obj, fields[key]) for key in fields}
                        row.setdefault("session", None)
                        row["session"] = row["session"] or os.path.basename(path)
                        yield row
            except OSError:
                continue
        return
    import sqlite3
    path = expand_path(source["path"])
    if not os.path.exists(path):
        return
    db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
    try:
        cursor = db.execute(source["query"])
        names = [d[0] for d in cursor.description]
        for values in cursor:
            yield dict(zip(names, values))
    finally:
        db.close()


def spec_entries(spec, since):
    unit, seen = spec.get("timeUnit", "iso"), set()
    for row in spec_rows(spec, since):
        try:
            when = parse_time(row.get("timestamp"), unit)
        except (ValueError, OverflowError, OSError):
            continue
        if row.get("id") is not None:
            if row["id"] in seen:
                continue
            seen.add(row["id"])
        yield {"when": when, "model": str(row.get("model") or "?"), "cost": spec_cost(spec, row),
               "session": str(row.get("session") or "?"), "title": row.get("title")}


def spec_usage(spec, entries=None):
    if entries is None:
        entries = list(spec_entries(spec, min(history_start, week_start, month_start)))
    by_day, by_model, today_sessions = defaultdict(float), defaultdict(float), set()
    totals, models, titles = defaultdict(float), defaultdict(lambda: defaultdict(float)), {}
    for e in entries:
        day = e["when"].date()
        by_day[day] += e["cost"]
        totals[e["session"]] += e["cost"]
        models[e["session"]][e["model"]] += e["cost"]
        if e["title"]:
            titles[e["session"]] = str(e["title"])
        if day == today:
            by_model[e["model"]] += e["cost"]
            today_sessions.add(e["session"])
    top = sorted((s for s in today_sessions if totals[s] > 0), key=lambda s: -totals[s])[:3]
    chats = [{"name": (titles.get(s) or s)[:60], "cost": round(totals[s], 4),
              "model": max(models[s], key=models[s].get).split("/")[-1]} for s in top]
    return {**period_totals(by_day), "monthLabel": f"Since {month_start.strftime('%b %-d')}", "daily": history(by_day),
            "models": top_models(by_model), "rate": 0.0, "chats": chats}


def plugin_sources():
    """Tools declared by JSON specs in ~/.config/ai-usage/tools. A broken spec shows up as a tool with an error."""
    specs, problems = load_tool_specs()
    sources = [(spec["id"], spec["name"].strip(), lambda spec=spec: spec_usage(spec)) for spec in specs if spec_present(spec)]
    for filename, problem in problems.items():
        def fail(filename=filename, problem=problem):
            raise RuntimeError(f"Invalid tool spec {filename}: {problem}")
        sources.append((f"spec-{os.path.splitext(filename)[0].lower()[:24]}", f"Spec {filename}", fail))
    return sources


SOURCES = [("cursor", "Cursor", cursor), ("claude", "Claude Code", claude),
           ("opencode", "OpenCode", opencode), ("deepseek", "DeepSeek", deepseek),
           ("pi", "Pi", pi)]
COLLECTOR_TIMEOUT_SECONDS = 45


def codex_binary():
    candidates = [shutil.which("codex", path=ENV["PATH"]),
                  "/opt/homebrew/bin/codex", "/usr/local/bin/codex",
                  "/Applications/ChatGPT.app/Contents/Resources/codex-cli/CodexCLI.app/Contents/MacOS/codex",
                  "/Applications/Codex.app/Contents/Resources/codex",
                  os.path.join(HOME, ".local/bin/codex"), os.path.join(HOME, ".bun/bin/codex")]
    return next((p for p in candidates if p and os.path.isfile(p) and os.access(p, os.X_OK)), None)


def codex():
    # Only account reads: never start a turn, change auth, or consume reset credits.
    process = subprocess.Popen([codex_binary(), "app-server", "--listen", "stdio://"],
                               stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ)
    pending = b""

    def request(request_id, method, params=None):
        nonlocal pending
        message = {"id": request_id, "method": method}
        if params is not None:
            message["params"] = params
        process.stdin.write((json.dumps(message) + "\n").encode())
        process.stdin.flush()
        deadline = time.monotonic() + 25
        while time.monotonic() < deadline:
            if b"\n" not in pending:
                if not selector.select(max(0, deadline - time.monotonic())):
                    break
                chunk = os.read(process.stdout.fileno(), 65536)
                if not chunk:
                    raise RuntimeError("Codex app-server closed the connection")
                pending += chunk
                continue
            line, pending = pending.split(b"\n", 1)
            response = json.loads(line)
            if response.get("id") == request_id:
                if "error" in response:
                    raise RuntimeError(response["error"].get("message", "Codex account unavailable"))
                return response["result"]
        raise TimeoutError("Codex account read timed out. Open Codex and check your sign-in.")

    try:
        request(1, "initialize", {"clientInfo": {"name": "ai_usage_bar", "version": "1.1"}})
        process.stdin.write(b'{"method":"initialized"}\n')
        process.stdin.flush()
        result = request(2, "account/rateLimits/read")
        buckets = result.get("rateLimitsByLimitId") or {"codex": result.get("rateLimits")}
        quotas = []
        for bucket_id, bucket in buckets.items():
            if not bucket:
                continue
            for key in ("primary", "secondary"):
                window = bucket.get(key)
                if not window or window.get("usedPercent") is None:
                    continue
                minutes = window.get("windowDurationMins")
                label = "Semanal" if minutes == 10080 else (f"{minutes // 60} horas" if minutes and minutes % 60 == 0 else f"{minutes} min" if minutes else key)
                quotas.append({"id": f"{bucket_id}-{key}", "label": label if len(buckets) == 1 else f"{bucket.get('limitName') or bucket_id} · {label}",
                               "usedPercent": window["usedPercent"], "resetsAt": window.get("resetsAt"),
                               "windowMins": minutes})
        if not quotas:
            raise RuntimeError("Codex did not return subscription quotas for this account")
        return {"today": 0, "week": 0, "month": 0, "monthLabel": "", "daily": [], "models": [],
                "quotas": quotas, "mode": "quota", "scope": "account"}
    finally:
        selector.close()
        process.terminate()
        try:
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
        process.stdin.close()
        process.stdout.close()


def known_tool_ids():
    return {"codex", *(s[0] for s in SOURCES), *(spec["id"] for spec in load_tool_specs()[0])}


def detected_sources():
    cursor_data = os.path.join(HOME, "Library/Application Support/Cursor/User/globalStorage/state.vscdb")
    claude_data = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR", os.path.join(HOME, ".claude")), "projects")
    opencode_data = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.join(HOME, ".local/share")), "opencode")
    present = {"cursor": os.path.isfile(cursor_data) or os.path.isdir("/Applications/Cursor.app") or os.path.isdir(os.path.join(HOME, "Applications/Cursor.app")),
               "claude": os.path.isdir(claude_data) or shutil.which("claude", path=ENV["PATH"]) is not None,
               "opencode": os.path.isdir(opencode_data) or shutil.which("opencode", path=ENV["PATH"]) is not None,
               "deepseek": os.path.isdir(deepseek_sessions_dir()),
               "pi": os.path.isdir(pi_sessions_dir())}
    sources = [("codex", "Codex", codex)] if codex_binary() else []
    return sources + [s for s in SOURCES if present[s[0]]] + plugin_sources()


def collect(source):
    tool_id, name, fn = source
    try:
        data = fn()
        data = {k: round(v, 4) if isinstance(v, float) else v for k, v in data.items()}
        return {"id": tool_id, "name": name, "error": None, "mode": "cost", "budget": tool_budget(tool_id),
                "alertsEnabled": configuration().get("tools", {}).get(tool_id, {}).get("alertsEnabled", True), **data}
    except Exception as err:  # one broken source must not blank the whole bar
        return {"id": tool_id, "name": name, "error": str(err) or type(err).__name__,
                "mode": "quota" if tool_id == "codex" else "cost", "today": 0, "week": 0, "month": 0, "monthLabel": "", "daily": [], "models": []}


def stop_process_group(process):
    """Stop a timed-out collector and any CLI processes it started."""
    for sig, grace in ((signal.SIGTERM, 2), (signal.SIGKILL, 2)):
        try:
            os.killpg(process.pid, sig)
        except ProcessLookupError:
            pass
        try:
            return process.communicate(timeout=grace)
        except subprocess.TimeoutExpired:
            continue
    return process.communicate()


def collect_isolated(source, timeout=COLLECTOR_TIMEOUT_SECONDS, command=None):
    """Run one source separately so a stuck provider cannot block healthy results."""
    tool_id, name, _ = source
    command = command or [sys.executable, os.path.abspath(__file__), "--collect-tool", tool_id]
    try:
        process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                   text=True, env=ENV, start_new_session=True)
        try:
            stdout, stderr = process.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            stop_process_group(process)
            raise TimeoutError(f"{name} refresh timed out after {timeout} seconds. Try again.")
        if process.returncode:
            raise RuntimeError(stderr.strip() or f"{name} collector exited with status {process.returncode}.")
        result = json.loads(stdout)
        if result.get("id") != tool_id:
            raise ValueError("Collector returned data for the wrong tool.")
        return result
    except (OSError, RuntimeError, TimeoutError, ValueError) as err:
        return {"id": tool_id, "name": name, "error": str(err) or type(err).__name__,
                "mode": "quota" if tool_id == "codex" else "cost", "today": 0, "week": 0, "month": 0,
                "monthLabel": "", "daily": [], "models": []}


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "--collect-tool":
        source = next((s for s in detected_sources() if s[0] == sys.argv[2]), None)
        if source is None:
            raise ValueError(f"Tool not detected: {sys.argv[2]}")
        json.dump(collect(source), sys.stdout)
        return 0
    if len(sys.argv) == 3 and sys.argv[1] == "--set-budget":
        amount = float(sys.argv[2])
        if not math.isfinite(amount) or amount < 0:
            raise ValueError("Global daily budget must be finite and non-negative")
        def update(config):
            config["globalBudget"] = {"amount": amount, "period": "daily"} if amount else None
            if amount:
                config["dailyBudget"] = amount  # Preserve the old CLI/config contract.
        update_configuration(update)
        print("Global daily budget saved")
        return 0
    if len(sys.argv) >= 3 and sys.argv[1] == "--set-indicator":
        mode, ids = sys.argv[2], sys.argv[3:]
        known = known_tool_ids()
        valid = ((mode in ("summary", "urgent") and len(ids) <= 1)
                 or (mode == "fixed" and len(ids) == 1 and ids[0] in known)
                 or (mode == "pinned" and 1 <= len(ids) <= 2 and len(set(ids)) == len(ids) and set(ids) <= known))
        if not valid:
            raise ValueError("Usage: ai-usage --set-indicator summary|urgent|fixed TOOL|pinned TOOL [TOOL]")
        def update(config):
            config["indicator"] = {"mode": mode, "toolId": ids[0] if mode == "fixed" else None}
            if mode == "pinned":
                config["indicator"]["toolIds"] = ids
        update_configuration(update)
        print("Indicator preference saved")
        return 0
    if len(sys.argv) == 4 and sys.argv[1] == "--set-alerts":
        tool_id, value = sys.argv[2:]
        if tool_id not in known_tool_ids() or value not in ("on", "off"):
            raise ValueError("Usage: ai-usage --set-alerts TOOL on|off")
        update_configuration(lambda config: _tool_preference(config, tool_id).__setitem__("alertsEnabled", value == "on"))
        print("Alert preference saved")
        return 0
    if len(sys.argv) == 5 and sys.argv[1] == "--set-tool-budget":
        tool_id, period, value = sys.argv[2:]
        amount = float(value)
        if tool_id not in known_tool_ids() - {"codex"} or period not in ("daily", "monthly") or not math.isfinite(amount) or amount < 0:
            raise ValueError("Use a supported cost tool, daily|monthly and a non-negative amount (0 removes the budget)")
        update_configuration(lambda config: _tool_preference(config, tool_id).__setitem__(
            "budget", {"amount": amount, "period": period} if amount else None))
        print("Tool budget saved")
        return 0
    if len(sys.argv) == 4 and sys.argv[1] == "--set-tool-enabled":
        tool_id, value = sys.argv[2:]
        if tool_id not in known_tool_ids() or value not in ("on", "off"):
            raise ValueError("Usage: ai-usage --set-tool-enabled TOOL on|off")
        update_configuration(lambda config: _tool_preference(config, tool_id).__setitem__("enabled", value == "on"))
        print("Tool filter saved")
        return 0
    if len(sys.argv) > 1:
        raise ValueError("Unknown command")
    detected = detected_sources()
    with ThreadPoolExecutor() as pool:
        tools = list(pool.map(collect_isolated, [s for s in detected if tool_enabled(s[0])]))
    json.dump(output_payload(tools, detected), sys.stdout)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError, ValueError) as err:
        print(f"ai-usage: {err}", file=sys.stderr)
        sys.exit(1)
